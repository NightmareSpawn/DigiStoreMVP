# --- Database ---
# Local dev (SQLite, zero config):
DATABASE_URL="file:./dev.db"
# Production (Postgres, e.g. Neon/Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-string"

# --- SMS OTP provider ---
# In dev mode, if left empty, OTP codes are just printed to the server console/log.
# Plug a real Iranian SMS provider later (e.g. Kavenegar, ippanel, Farapayamak).
SMS_PROVIDER_API_KEY=""

# --- Zarinpal (sandbox works out of the box, no signup needed for testing) ---
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX="true"

# Base URL of the site (used for payment callback URLs)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- First super admin (used by the seed script) ---
SEED_SUPER_ADMIN_PHONE="09120000000"
SEED_SUPER_ADMIN_NAME="Super Admin"
